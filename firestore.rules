rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "jerryhun47@gmail.com" ||
        request.auth.token.email == "jerryweb471@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection - allows registration and profile reads/writes
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Wallets Collection - allows wallet updates
    match /wallets/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Platform Configuration & Tier Pricing
    match /platform_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders, Transactions, Deposits & Withdrawals
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /transactions/{txnId} {
      allow read, write: if true;
    }

    match /deposits/{depId} {
      allow read, write: if true;
    }

    match /withdrawals/{wdId} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
